{ config, lib, pkgs, ... }:

with lib;

let
  cfg = config.elastinix.services.documenso;

in {
  options.elastinix.services.documenso = {
    enable = mkEnableOption "Documenso document signing service";

    publicUrl = mkOption {
      type = types.str;
      description = "Public URL where Documenso will be accessible (e.g., https://documenso.example.com)";
    };

    image = mkOption {
      type = types.str;
      default = "documenso/documenso:latest";
      description = "Docker image to use for Documenso";
    };

    user = mkOption {
      type = types.str;
      default = "documenso";
      description = "User to run the service as";
    };

    group = mkOption {
      type = types.str;
      default = "documenso";
      description = "Group to run the service as";
    };

    database = {
      host = mkOption {
        type = types.str;
        description = "PostgreSQL database host";
      };

      port = mkOption {
        type = types.port;
        default = 5432;
        description = "PostgreSQL database port";
      };

      name = mkOption {
        type = types.str;
        description = "PostgreSQL database name";
      };

      user = mkOption {
        type = types.str;
        description = "PostgreSQL database user";
      };

      passwordFile = mkOption {
        type = types.path;
        description = "Path to file containing PostgreSQL database password";
      };
    };

    smtp = {
      host = mkOption {
        type = types.str;
        description = "SMTP server host";
      };

      port = mkOption {
        type = types.port;
        description = "SMTP server port";
      };

      fromAddress = mkOption {
        type = types.str;
        description = "Email address to send from";
      };

      fromName = mkOption {
        type = types.str;
        description = "Name to display as sender";
      };

      username = mkOption {
        type = types.nullOr types.str;
        default = null;
        description = "Optional SMTP username for authentication";
      };

      passwordFile = mkOption {
        type = types.nullOr types.path;
        default = null;
        description = "Optional path to file containing SMTP password";
      };

      secure = mkOption {
        type = types.bool;
        default = false;
        description = "Use TLS for SMTP connection";
      };
    };

    storage = {
      type = mkOption {
        type = types.enum [ "s3" ];
        default = "s3";
        description = "Storage backend type (currently only s3 is supported)";
      };

      bucket = mkOption {
        type = types.str;
        description = "S3 bucket name for document storage";
      };

      endpoint = mkOption {
        type = types.str;
        description = "S3 endpoint URL";
      };

      region = mkOption {
        type = types.str;
        description = "S3 region";
      };

      credentialsFile = mkOption {
        type = types.path;
        description = "Path to file containing AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY";
      };
    };

    jobs = {
      provider = mkOption {
        type = types.enum [ "bullmq" "local" ];
        default = "bullmq";
        description = "Background job provider (bullmq uses Redis, local uses PostgreSQL)";
      };

      redis = {
        host = mkOption {
          type = types.str;
          default = "127.0.0.1";
          description = "Redis host for BullMQ job queue";
        };

        port = mkOption {
          type = types.port;
          default = 6379;
          description = "Redis port for BullMQ job queue";
        };

        passwordFile = mkOption {
          type = types.nullOr types.path;
          default = null;
          description = "Optional path to file containing Redis password";
        };

        prefix = mkOption {
          type = types.str;
          default = "documenso";
          description = "Redis key prefix for job queue isolation";
        };
      };
    };

    secrets = {
      nextAuthSecretFile = mkOption {
        type = types.path;
        description = "Path to file containing NextAuth secret";
      };

      encryptionKeyFile = mkOption {
        type = types.path;
        description = "Path to file containing primary encryption key";
      };

      encryptionSecondaryKeyFile = mkOption {
        type = types.path;
        description = "Path to file containing secondary encryption key";
      };
    };

    signing = {
      certificateFile = mkOption {
        type = types.path;
        default = "/var/lib/documenso/cert.p12";
        description = "Path to PDF signing certificate file (PKCS#12 format)";
      };

      passphraseFile = mkOption {
        type = types.path;
        description = "Path to file containing certificate passphrase";
      };

      autoGenerate = mkOption {
        type = types.bool;
        default = false;
        description = "Automatically generate self-signed certificate if it doesn't exist (for development only)";
      };

      certificateContents = mkOption {
        type = types.nullOr types.str;
        default = null;
        description = "Base64-encoded PKCS#12 certificate contents (alternative to certificateFile)";
      };

      subject = {
        country = mkOption {
          type = types.str;
          default = "NL";
          description = "Certificate subject country code";
        };

        state = mkOption {
          type = types.str;
          default = "Province";
          description = "Certificate subject state/province";
        };

        locality = mkOption {
          type = types.str;
          default = "City";
          description = "Certificate subject locality/city";
        };

        organization = mkOption {
          type = types.str;
          default = "Organization";
          description = "Certificate subject organization";
        };

        commonName = mkOption {
          type = types.nullOr types.str;
          default = null;
          description = "Certificate subject common name (defaults to hostname)";
        };
      };
    };

    features = {
      disableSignup = mkOption {
        type = types.bool;
        default = false;
        description = "Disable new user signups";
      };

      allowedSignupDomains = mkOption {
        type = types.listOf types.str;
        default = [];
        description = "List of allowed email domains for signup (empty means all domains)";
      };

      disableTelemetry = mkOption {
        type = types.bool;
        default = true;
        description = "Disable telemetry data collection";
      };
    };

    oauth = {
      google = {
        clientId = mkOption {
          type = types.nullOr types.str;
          default = null;
          description = "Google OAuth client ID";
        };

        clientSecretFile = mkOption {
          type = types.nullOr types.path;
          default = null;
          description = "Path to file containing Google OAuth client secret";
        };
      };
    };
  };

  config = mkIf cfg.enable {
    # Assertions
    assertions = [
      {
        assertion = cfg.publicUrl != "";
        message = "elastinix.services.documenso.publicUrl must be set";
      }
    ];

    # User and group creation
    users.users = mkIf (cfg.user == "documenso") {
      documenso = {
        isSystemUser = true;
        group = cfg.group;
        description = "Documenso service user";
      };
    };

    users.groups = mkIf (cfg.group == "documenso") {
      documenso = {};
    };

    # Redis configuration when using BullMQ
    services.redis.servers = mkIf (cfg.jobs.provider == "bullmq") {
      documenso = {
        enable = true;
        bind = "127.0.0.1";
        port = cfg.jobs.redis.port;

        # Persistence for job queue durability
        settings = {
          appendonly = "yes";
          appendfsync = "everysec";

          # RDB snapshots
          save = [
            [ 900 1 ]    # After 900 sec if at least 1 key changed
            [ 300 10 ]   # After 300 sec if at least 10 keys changed
            [ 60 10000 ] # After 60 sec if at least 10000 keys changed
          ];
        } // (optionalAttrs (cfg.jobs.redis.passwordFile != null) {
          requirepass = "$REDIS_PASSWORD";
        });
      };
    };

    # Environment file generation
    systemd.services.documenso-env-setup = {
      description = "Generate Documenso environment file";
      before = [ "documenso.service" ];
      wantedBy = [ "multi-user.target" ];

      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        User = cfg.user;
        Group = cfg.group;
      };

      script = let
        envFile = "/var/lib/documenso/.env";

        # Helper to read file content
        readSecret = file: "\$(cat ${file})";

        # Build Redis URL
        redisUrl = if cfg.jobs.provider == "bullmq" then
          if cfg.jobs.redis.passwordFile != null then
            "redis://:${readSecret cfg.jobs.redis.passwordFile}@${cfg.jobs.redis.host}:${toString cfg.jobs.redis.port}"
          else
            "redis://${cfg.jobs.redis.host}:${toString cfg.jobs.redis.port}"
        else "";

        # Build database URL
        dbUrl = "postgresql://${cfg.database.user}:${readSecret cfg.database.passwordFile}@${cfg.database.host}:${toString cfg.database.port}/${cfg.database.name}";

      in ''
        mkdir -p /var/lib/documenso

        cat > ${envFile} <<EOF
        # Authentication & Crypto
        NEXTAUTH_SECRET=${readSecret cfg.secrets.nextAuthSecretFile}
        NEXT_PRIVATE_ENCRYPTION_KEY=${readSecret cfg.secrets.encryptionKeyFile}
        NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=${readSecret cfg.secrets.encryptionSecondaryKeyFile}

        # URLs
        NEXT_PUBLIC_WEBAPP_URL=${cfg.publicUrl}
        NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://127.0.0.1:3000

        # Database
        NEXT_PRIVATE_DATABASE_URL=${dbUrl}
        NEXT_PRIVATE_DIRECT_DATABASE_URL=${dbUrl}

        # SMTP
        NEXT_PRIVATE_SMTP_TRANSPORT=smtp-auth
        NEXT_PRIVATE_SMTP_HOST=${cfg.smtp.host}
        NEXT_PRIVATE_SMTP_PORT=${toString cfg.smtp.port}
        NEXT_PRIVATE_SMTP_FROM_NAME=${cfg.smtp.fromName}
        NEXT_PRIVATE_SMTP_FROM_ADDRESS=${cfg.smtp.fromAddress}
        ${optionalString (cfg.smtp.username != null) "NEXT_PRIVATE_SMTP_USERNAME=${cfg.smtp.username}"}
        ${optionalString (cfg.smtp.passwordFile != null) "NEXT_PRIVATE_SMTP_PASSWORD=${readSecret cfg.smtp.passwordFile}"}
        ${optionalString cfg.smtp.secure "NEXT_PRIVATE_SMTP_SECURE=true"}

        # Storage (S3)
        NEXT_PUBLIC_UPLOAD_TRANSPORT=${cfg.storage.type}
        NEXT_PRIVATE_UPLOAD_ENDPOINT=${cfg.storage.endpoint}
        NEXT_PRIVATE_UPLOAD_REGION=${cfg.storage.region}
        NEXT_PRIVATE_UPLOAD_BUCKET=${cfg.storage.bucket}

        # Read S3 credentials
        source ${cfg.storage.credentialsFile}
        NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
        NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY

        # Background Jobs
        NEXT_PRIVATE_JOBS_PROVIDER=${cfg.jobs.provider}
        ${optionalString (cfg.jobs.provider == "bullmq") ''
        NEXT_PRIVATE_REDIS_URL=${redisUrl}
        NEXT_PRIVATE_REDIS_PREFIX=${cfg.jobs.redis.prefix}
        ''}

        # Signing
        NEXT_PRIVATE_SIGNING_PASSPHRASE=${readSecret cfg.signing.passphraseFile}
        NEXT_PRIVATE_SIGNING_LOCAL_FILE_PATH=${cfg.signing.certificateFile}

        # Features
        ${optionalString cfg.features.disableSignup "NEXT_PUBLIC_DISABLE_SIGNUP=true"}
        ${optionalString (cfg.features.allowedSignupDomains != []) ''
        NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS=${concatStringsSep "," cfg.features.allowedSignupDomains}
        ''}
        ${optionalString cfg.features.disableTelemetry "DOCUMENSO_DISABLE_TELEMETRY=true"}

        # OAuth
        ${optionalString (cfg.oauth.google.clientId != null) "NEXT_PRIVATE_GOOGLE_CLIENT_ID=${cfg.oauth.google.clientId}"}
        ${optionalString (cfg.oauth.google.clientSecretFile != null) "NEXT_PRIVATE_GOOGLE_CLIENT_SECRET=${readSecret cfg.oauth.google.clientSecretFile}"}
        EOF

        chmod 0400 ${envFile}
      '';
    };

    # Certificate management
    systemd.services.documenso-cert-setup = mkIf cfg.signing.autoGenerate {
      description = "Generate Documenso signing certificate if needed";
      before = [ "documenso.service" ];
      wantedBy = [ "multi-user.target" ];

      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        User = cfg.user;
        Group = cfg.group;
      };

      script = let
        certFile = cfg.signing.certificateFile;
        commonName = if cfg.signing.subject.commonName != null
                     then cfg.signing.subject.commonName
                     else config.networking.hostName;
        subject = "/C=${cfg.signing.subject.country}/ST=${cfg.signing.subject.state}/L=${cfg.signing.subject.locality}/O=${cfg.signing.subject.organization}/CN=${commonName}";
      in ''
        if [ ! -f "${certFile}" ]; then
          echo "WARNING: Auto-generating self-signed certificate for DEVELOPMENT ONLY"
          echo "         Do NOT use in production environments!"

          mkdir -p $(dirname "${certFile}")

          # Generate private key and certificate
          ${pkgs.openssl}/bin/openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
            -keyout /tmp/documenso-private.key \
            -out /tmp/documenso-certificate.crt \
            -subj "${subject}"

          # Create PKCS#12 bundle
          ${pkgs.openssl}/bin/openssl pkcs12 -export \
            -out "${certFile}" \
            -inkey /tmp/documenso-private.key \
            -in /tmp/documenso-certificate.crt \
            -passout file:${cfg.signing.passphraseFile}

          # Cleanup temporary files
          rm -f /tmp/documenso-private.key /tmp/documenso-certificate.crt

          # Set proper permissions
          chmod 0400 "${certFile}"

          echo "Self-signed certificate generated at ${certFile}"
        fi
      '';
    };

    # Handle certificate contents if provided
    systemd.services.documenso-cert-contents = mkIf (cfg.signing.certificateContents != null) {
      description = "Deploy Documenso signing certificate from contents";
      before = [ "documenso.service" ];
      wantedBy = [ "multi-user.target" ];

      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        User = cfg.user;
        Group = cfg.group;
      };

      script = ''
        mkdir -p $(dirname "${cfg.signing.certificateFile}")
        echo "${cfg.signing.certificateContents}" | ${pkgs.coreutils}/bin/base64 -d > "${cfg.signing.certificateFile}"
        chmod 0400 "${cfg.signing.certificateFile}"
      '';
    };

    # Enable virtualisation backend
    virtualisation.oci-containers.backend = lib.mkDefault "docker";

    # Main Documenso service
    virtualisation.oci-containers.containers.documenso = {
      image = cfg.image;

      ports = [
        "3000:3000"
      ];

      volumes = [
        "${cfg.signing.certificateFile}:${cfg.signing.certificateFile}:ro"
        "/var/lib/documenso:/app/data"
      ];

      environmentFiles = [
        "/var/lib/documenso/.env"
      ];

      extraOptions = [
        "--network=host"
      ];
    };

    # Enhance the auto-created systemd service
    systemd.services."${config.virtualisation.oci-containers.backend}-documenso" = {
      description = "Documenso Document Signing Service";

      after = [
        "network.target"
        "postgresql.service"
        "documenso-env-setup.service"
      ] ++ optional (cfg.jobs.provider == "bullmq") "redis-documenso.service"
        ++ optional cfg.signing.autoGenerate "documenso-cert-setup.service"
        ++ optional (cfg.signing.certificateContents != null) "documenso-cert-contents.service";

      requires = optional (cfg.jobs.provider == "bullmq") "redis-documenso.service";

      # Database migrations
      preStart = let
        backendBin = "${pkgs.${config.virtualisation.oci-containers.backend}}/bin/${config.virtualisation.oci-containers.backend}";
      in ''
        # Wait for environment file
        while [ ! -f /var/lib/documenso/.env ]; do
          echo "Waiting for environment file..."
          sleep 1
        done

        # Run migrations
        echo "Running database migrations..."
        ${backendBin} run --rm \
          --env-file /var/lib/documenso/.env \
          --network=host \
          ${cfg.image} \
          npx prisma migrate deploy --schema /app/packages/prisma/schema.prisma
      '';

      serviceConfig = {
        StateDirectory = lib.mkForce "documenso";
        StateDirectoryMode = lib.mkForce "0700";

        # Timeouts
        TimeoutStartSec = lib.mkForce "300s";
        TimeoutStopSec = lib.mkForce "30s";

        # Security hardening
        NoNewPrivileges = lib.mkForce true;
        PrivateTmp = lib.mkForce true;
        ProtectSystem = lib.mkForce "strict";
        ProtectHome = lib.mkForce true;
        ReadWritePaths = lib.mkForce [ "/var/lib/documenso" ];
        RestrictAddressFamilies = lib.mkForce [ "AF_INET" "AF_INET6" ];
      };
    };
  };
}
