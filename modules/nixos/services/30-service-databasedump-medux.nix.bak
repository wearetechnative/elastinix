{ config, pkgs, tfvarsfile, ... }:

let
  tfvarsContent = builtins.readFile tfvarsfile;
  tfvars = builtins.fromJSON tfvarsContent;
  infra_environment = tfvars.infra_environment;
  project = tfvars.project;  #technative-workloads",
  dataDir = "/data/mysqldump";

  bin.aws = "${pkgs.awscli2}/bin/aws";
  bin.lego = "${pkgs.lego}/bin/lego";
  bin.mysqldump = "${pkgs.mariadb}/bin/mysqldump";
  bin.mysql = "${pkgs.mariadb}/bin/mysql";
  bin.tar = "${pkgs.gnutar}/bin/tar";
  bin.logger = "${pkgs.logger}/bin/logger";
  bin.gzip = "${pkgs.gzip}/bin/gzip";
  bin.systemd-cat = "${pkgs.systemd}/bin/systemd-cat";
  bin.awk = "${pkgs.awk}/bin/awk";

in {
  #  age.identityPaths = [ "/etc/ssh/ssh_workloads_key" ];
  #  age.secrets.backup_database = {
  #   file = ../../../secrets/backup_database_${infra_environment}.age;
  #   owner = "root";
  #   group = "root";
  #   path = "/run/secrets/backup_database.env";
  #       mode = "0660"; 
  #  };
  ## TODO: 
  # Variable for onCalender time
  # Variable for lograte paths
  # Variable aws s3 sync commando s3 path


  systemd.timers."database-backup" = {
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnCalendar="*-*-* 22:00:00";
      # OnCalendar is UTC
      Unit = "database-backup.service";
    };
  };


 services.logrotate.settings = {
  header = {
   dateext = true;
  };
  "multiple paths" = {
	  files = [
      "/var/log/DatabaseBackup.log"
	    "/var/log/messages"
	 	  "/var/log/warn"
      "/var/log/mail"
	 ];
   frequency = "daily"; 
   rotate = 7;
};
 };

  systemd.services."database-backup" =
  {
    serviceConfig= {
		 Type = "oneshot";
     ReadWritePaths=["/tmp"];
    };
    # wantedBy = [ "multi-user.target" ];
		script = ''
			numberOfErrors=0
			trap '((numberOfErrors++))' ERR
      set +e
      logfile="/var/log/DatabaseBackup.log"
      export PATH=$PATH:/run/current-system/sw/bin
      exec > >(tee -a "$logfile" | systemd-cat -t database-backup ) 2>&1

			mysqlDumpPathBase="/data/mysqldump"
			backupMinimumFiles=5
			backupMinimumAge=7

      ${bin.aws} ssm get-parameter  --name /${infra_environment}/dbdump_env  --with-decryption --output text --query Parameter.Value > /tmp/backup_database.env

			config_files=("/tmp/backup_database.env" )

			echo "---- Start run mysqlDatabaseBackup $0) - $(date) ----"
			mkdir -p $mysqlDumpPathBase
			for cfg in "''${config_files[@]}";
			do
			 if [ -f "$cfg" ]; then
					 source "$cfg"


					 databaseHostBase=$(echo $DB_HOST | awk -F "." '{print $1}')

					 echo "--- Processing database host: $DB_HOST"
					 echo "------------------------"
					 echo "-- Database user: $DB_USER"
					 echo "-- Database host: $DB_HOST"
					 echo "-- Database port: $DB_PORT"
					 echo "------------------------"
					 databases=($(${bin.mysql}  -h $DB_HOST -u $DB_USER --password=$DB_PASSWORD -sN -e "show databases" | egrep -v 'information_schema|innodb|mysql|performance_schema|sys|tmp'))
					 for database in "''${databases[@]}"
					 do
							 echo "-- Start dump database: $database - $(date +"%Y%m%d-%H%M%S")"
							 mysqlDumpPath="$mysqlDumpPathBase/$DB_HOST/$database"
							 mysqlDumpFile="$mysqlDumpPath/$database-$(date +"%Y%m%d-%H%M%S").sql.gz"
							 mkdir -p $mysqlDumpPath

               ##/run/current-system/sw/bin/${bin.mysqldump} -h $DB_HOST -u $DB_USER --password=$DB_PASSWORD $database > $mysqlDumpFile

               ## Backup Structure
							 mysqlDumpFileStructure="$mysqlDumpPath/structure-$database-$(date +"%Y%m%d-%H%M%S").sql.gz"
               ${bin.mysqldump} -h $DB_HOST --skip-triggers --skip-set-charset -d -n -P 3306 -u $DB_USER --password=$DB_PASSWORD $database --skip-ssl | ${bin.gzip} > $mysqlDumpFileStructure

               ## Backup Routines
							 mysqlDumpFileRoutines="$mysqlDumpPath/routines-$database-$(date +"%Y%m%d-%H%M%S").sql.gz"
               ${bin.mysqldump} -h $DB_HOST -a --routines --no-create-info --skip-set-charset -d -n --skip-triggers --add-drop-table -P 3306  -u $DB_USER --password=$DB_PASSWORD $database --skip-ssl | sed -e  's/DEFINER=`[^`]*`@`[^`]*`//'  -e 's/CREATE DEFINER=.*FUNCTION/CREATE FUNCTION/' -e 's/CREATE DEFINER=.*PROCEDURE/CREATE PROCEDURE/'	  | ${bin.gzip} > $mysqlDumpFileRoutines
               
               ## Backup Triggers
							 mysqlDumpFileTriggers="$mysqlDumpPath/triggers-$database-$(date +"%Y%m%d-%H%M%S").sql.gz"
               mysql   -h $DB_HOST -P 3306 -u $DB_USER --password=$DB_PASSWORD  $database -N -B -e 'show triggers;'| tee /tmp/triggers.sql | awk -F "\t" '{print "DROP TRIGGER IF EXISTS", $1, "$$ CREATE TRIGGER", $1, $5, $2, "ON", $3, "FOR EACH ROW", $4, "$$"}' | printf 'DELIMITER $$\n%b\nDELIMITER ;\n' "$(</dev/stdin)" | ${bin.gzip} > $mysqlDumpFileTriggers
               rm /tmp/triggers.sql


               ## Backup Data
							 mysqlDumpFileData="$mysqlDumpPath/data-$database-$(date +"%Y%m%d-%H%M%S").sql.gz"
               ${bin.mysqldump} -h $DB_HOST --skip-triggers --skip-comments --hex-blob --single-transaction -t -P 3306 -u $DB_USER --password=$DB_PASSWORD $database --skip-ssl | ${bin.gzip} > $mysqlDumpFileData


               cat $mysqlDumpFileRoutines $mysqlDumpFileStructure $mysqlDumpFileData $mysqlDumpFileTriggers > $mysqlDumpFile
               echo "-- Dumpfile: $mysqlDumpFile"
							 echo "-- End dump database: $database - $(date +"%Y%m%d-%H%M%S")"
							 echo ""
					 done
					 unset databases
					 echo ""
			 fi
			done

			echo "--- Backup retention"
			echo "--- Keeping minimum of #$backupMinimumFiles backup files and keeping backups for a minimum of #$backupMinimumAge days."
			for mysqlDumpPathBase in "$mysqlDumpPathBase"/*/  ; do
			 ls -1tr $mysqlDumpPathBase 2>/dev/null | head -n -2 | while read file; do
			fileToCheck=$mysqlDumpPathBase/$file
				if [ -f "$fileToCheck" ] && [ "$(find "$fileToCheck" -mtime +7 )" ]; then
								echo "--Remove backup file: $fileToCheck"
								rm $fileToCheck
				fi
			done
			done

     echo "--- Sync backup files to S3"
     aws s3 sync $mysqlDumpPathBase s3://database-backups-improvement-it-medux-${infra_environment}/


			if [[ $numberOfErrors -ne 0 ]];
			then
				echo "---- Timestamp: $(date)"
				echo "---- Finish run mysqlDatabaseBackup with errors ----"
			else
				echo "---- Timestamp: $(date)"
				echo "---- Finish run mysqlDatabaseBackup successfully ----"
			fi

		'';
  };


}
