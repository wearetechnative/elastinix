{ pkgs, lib, config, tfvars, ... }:


let
  cfg = config.elastinix.services.phpfpm;

  ## TODO: Ref should be a variable options
  fossarPhps2 = builtins.getFlake "github:fossar/nix-phps/12e9be0ec521654484c4adad829ff53bdad9fa19";
  bin.aws = "${pkgs.awscli2}/bin/aws";
  bin.jq = "${pkgs.jq}/bin/jq";
  bin.tar = "${pkgs.gnutar}/bin/tar";
  bin.openssl = "${pkgs.openssl}/bin/openssl";

  app = cfg.appname;
  dataDir = "/var/www/${app}/html";
  appDir = "/var/www/${app}";

  user = cfg.appname;
  group = cfg.appname;
in

{
  options.elastinix.services.phpfpm = {
    enable = lib.mkEnableOption "Phpfpm app";

    appname = lib.mkOption {
      type = lib.types.str;
      description = "";
    };

    phpVersion = lib.mkOption {
      type = lib.types.str;
      description = "";
    };

    phpOptions = lib.mkOption {
      type = lib.types.lines;
      description = "";
    };

    nginxRootPath = lib.mkOption {
      type = lib.types.path;
      default = "";
      description = "";
    };

    domain = lib.mkOption {
      type = lib.types.str;
      description = "";
    };


    s3Deploy = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "";
    };

    s3DeployOptions = lib.mkIf cfg.s3Deploy {
      s3Deploy.tarfile = lib.mkOption {
        type = lib.types.path;
        description = "";
      };
      s3Deploy.envPatchList = lib.mkOption {
        type = lib.types.list;
        default = [];
      };
      s3Deploy.postDeployCmdsList = lib.mkOption {
        type = lib.types.list;
        default = [];
      };
      s3Deploy.artifactBucket = lib.mkOption {
        type = lib.types.str;
        default = "";
      };
    };

    phpfpm.settings = lib.mkOption {
      type = with lib.types; attrsOf (oneOf [ str int bool ]);
      description = "";
      default = {
        "pm" = "dynamic";
        "pm.max_children" = 32;
        "pm.max_requests" = 500;
        "pm.start_servers" = 2;
        "pm.min_spare_servers" = 2;
        "pm.max_spare_servers" = 5;
        "php_admin_value[error_log]" = "stderr";
        "php_admin_flag[log_errors]" = true;
        "listen.owner" = config.services.nginx.user;
        "listen.group" = config.services.nginx.group;
        "listen.mode" = "0660";
        "catch_workers_output" = 1;
      };
    };
  };

  config = lib.mkIf cfg.enable {

    config = lib.mkIf cfg.s3Deploy {
      # DEPLOY
      systemd.timers."${app}-s3-deploy" = {
        wantedBy = [ "timers.target" ];
        timerConfig = {
          OnBootSec = "1m";
          OnUnitActiveSec = "1m";
          Unit = "${app}-s3-deploy.service";
        };
      };

      systemd.services."${app}-s3-deploy" =
        let
          patchCmds = lib.strings.concatStrings (builtins.map (patchPair: ''
            ${bin.aws} ssm get-parameter --name ${patchPair.paramstore_key} --with-decryption  --output text --query Parameter.Value > ${appDir}${patchPair.dest_path}
          '') cfg.s3Deploy.envPatchList);

          postDeployCmds = lib.strings.concatStrings (builtins.map (postDeployCommand: ''
            ${postDeployCommand}
          '') cfg.s3Deploy.postDeployCmdsList);
        in
          {
          serviceConfig.Type = "oneshot";
          wantedBy = [ "multi-user.target" ];
          script = ''

      mkdir -p ${dataDir}
      export PATH=$PATH:${pkgs.gzip}/bin
      export LOCAL_VERSION=$(cat ${appDir}/sourcecode_version_id)
      ${bin.aws} s3api list-object-versions --bucket ${cfg.s3Deploy.artifactBucket} --prefix ${cfg.s3Deploy.tarfile} | ${bin.jq} '.Versions | .[] | select(.IsLatest)|.VersionId' > ${appDir}/sourcecode_version_id || echo "none" > ${appDir}/sourcecode_version_id
      export REMOTE_VERSION=$(cat ${appDir}/sourcecode_version_id)

      echo "S3-DEPLOY: Comparing local and remote versions"
      echo " local: $LOCAL_VERSION"
      echo " remote: $REMOTE_VERSION"

      if [[ "$LOCAL_VERSION" != "$REMOTE_VERSION" ]]; then

        echo "S3-DEPLOY: Creating backup"
        ${bin.tar} czf ${appDir}/backup-$(date +"%Y_%m_%d_%I_%M_%p")-${cfg.s3Deploy.tarfile} ${dataDir}

        echo "S3-DEPLOY: Removing earlier backups"
        ls -tp ${appDir}/backup-* | grep -v '/$'| tail -n +4 | xargs -I {} rm -- {}

        echo "S3-DEPLOY: Installing new version"
        ${bin.aws} s3 cp s3://${cfg.s3Deploy.artifactBucket}/${cfg.s3Deploy.tarfile} /tmp/
        rm -Rf ${dataDir}
        mkdir -p ${dataDir}
        ${bin.tar} xzf /tmp/${cfg.s3Deploy.tarfile} -C ${dataDir}

        echo "S3-DEPLOY: Applying patch list from Parameter Store"
        ${patchCmds}

        cd ${dataDir}
        ${postDeployCmds}

        chown -R ${user}:${group} ${dataDir}

        systemctl restart phpfpm-${app}.service
      fi

      '';
      };
    };

  users.groups.${app}.members = [ "${user}" ];
  users.users.${user} = {
    isSystemUser = true;
    group = group;
  };
  users.users.nginx.extraGroups = [ "${group}" "acme" ];

  services.phpfpm.pools.${app} = {
    user = app;

    phpOptions = cfg.phpOptions;
    phpPackage = fossarPhps2.packages.x86_64-linux.${cfg.phpVersion};

    settings = cfg.phpfpm.settings;
  };


  services.nginx = let

    ## TODO: Options below are to static and to specific for smartMC

    # Tenary expression to check if the environment is non-prod due to difference in directory name and Json environment name.
    infra_environment = if "${tfvars.infra_environment}" == "non-prod" then "nonprod" else "${tfvars.infra_environment}";

    # Read and Import the Nginx configuration file for the app.
    file_to_import = ./../../../infra_environments/${infra_environment}/nginx_templates/nginx_${app}.nix;

    # If Files exists, import the file, else use the default configuration.
    nginx_conf_code = if (builtins.pathExists file_to_import)
      then import file_to_import
      {
        inherit dataDir; inherit config; inherit pkgs; inherit app;
      }

    else
      {
      root = "${dataDir}${cfg.nginx_root_path}"; # The starting directory where the webserver serves files

      extraConfig = ''
              index index.php;
      '';

      locations."~ ^(.+\\.php)(.*)$"  = {
        extraConfig = ''
              # Check that the PHP script exists before passing it
              try_files $fastcgi_script_name =404;
              include ${config.services.nginx.package}/conf/fastcgi_params;
              fastcgi_split_path_info ^(.+\.php)(.*)$;

              #fastcgi_split_path_info ^(.+\.php)(/.+)$;
              fastcgi_pass unix:${config.services.phpfpm.pools.${app}.socket};
              fastcgi_param  SCRIPT_FILENAME  $document_root$fastcgi_script_name;
              fastcgi_param  PATH_INFO        $fastcgi_path_info;
              include ${pkgs.nginx}/conf/fastcgi.conf;
        '';
      };
    };


    # Add Route53 Healthheeck path to Nginx configuration.
    all_locations = nginx_conf_code.locations // {
      "/healthcheck" = {
        extraConfig = ''
          access_log off;
          return 200 'OK';
        '';
      };
    };

    # Combine the Nginx configuration with the Healthcheck path.
    nginx_conf_code_final = nginx_conf_code // {
      locations = all_locations;
    };

  in

    {
    enable = true;
    serverNamesHashBucketSize = 128;

    virtualHosts = {
      ${cfg.domain} = nginx_conf_code_final;
    };
  };


  systemd.services."${app}-initial-index-php" = {
    serviceConfig.Type = "oneshot";
    wantedBy = [ "multi-user.target" ];
    script = ''

      if [ ! -f ${dataDir}/index.php ]; then
        mkdir -p ${dataDir}

        touch ${dataDir}/index.php

        echo "<h1> ${app} </h1>" >> ${dataDir}/index.php
        echo "<a href=\"./info.php\">phpinfo...</a>" >> ${dataDir}/index.php

        touch ${dataDir}/info.php

        echo "<?php" >> ${dataDir}/info.php
        echo "phpinfo();" >> ${dataDir}/info.php
        echo "?>" >> ${dataDir}/info.php

        chown -Rc ${app}:${app} ${dataDir}
      fi

      '';
    };
  };
}
