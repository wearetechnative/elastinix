{ pkgs, fossarPhps, lib, config, appname, phpVersion, phpOptions ? "", domain, artifactBucket, tarfile, envPatchList, uid, ... }:

let
  certbasedir = "/data/acme";
  certEmail = "sysadmin+rrs@rtechnative.eu";
  certdir = "${certbasedir}/${appname}";
  certfile = "${certdir}/certificates/${domain}.crt";
  certkeyfile = "${certdir}/certificates/${domain}.key";

  app = appname;
  dataDir = "/var/www/${app}/html";
  appDir = "/var/www/${app}";

  php_version = phpVersion;

  bin.aws = "${pkgs.awscli2}/bin/aws";
  bin.lego = "${pkgs.lego}/bin/lego";
  bin.git = "${pkgs.git}/bin/git";
  bin.awk = "${pkgs.gawk}/bin/awk";
  bin.jq = "${pkgs.jq}/bin/jq";
  bin.tar = "${pkgs.gnutar}/bin/tar";
  bin.openssl = "${pkgs.openssl}/bin/openssl";
  bin.composer = "${pkgs.php83Packages.composer}/bin/composer";


  envfile = (import ../nix-lib/rrs_phpenvfile.nix {env = {
    DB_USERNAME = "";
    DB_PASSWORD = "";
    DB_HOST = "";
    DB_NAME = "";
  };});

in {
  users.groups.${app} = {
    members = [ "${app}" ];
    gid = uid;
  };
  users.users.${app} = {
    isSystemUser = true;
    group = "${app}";
    uid = uid;
  };
  users.users.nginx.extraGroups = [ "${app}" "acme" ];

    environment.systemPackages = [
    # pkgs.${php_version}Packages.composer
    #(pkgs."${php_version}Packages".composer)
    pkgs."${php_version}Packages".composer
  ];

  services.phpfpm.pools.${app} = {
    user = app;
    phpOptions = phpOptions;
    phpPackage = fossarPhps.packages.x86_64-linux.${phpVersion};
    settings = {
      "pm" = "dynamic";
      "pm.max_children" = 32;
      "pm.max_requests" = 500;
      "pm.start_servers" = 2;
      "pm.min_spare_servers" = 2;
      "pm.max_spare_servers" = 5;
      "php_admin_value[error_log]" = "stderr";
      "php_admin_flag[log_errors]" = true;
      "listen.owner" = config.services.nginx.user;
      "listen.group" = config.services.nginx.group;
      "listen.mode" = "0660";
      "catch_workers_output" = 1;
      "php_admin_value[post_max_size]" = "220M";
      "php_admin_value[memory_limit]" = "1536M";
      "php_admin_value[upload_max_filesize]" = "200M";
    };
  };

  security.acme = {
    acceptTerms = true;
    defaults.email = "sysadmin+rrs@technative.eu";
  };

  services.nginx = {
    enable = true;
    serverNamesHashBucketSize = 128;
    clientMaxBodySize = "50m";

    virtualHosts = {
      "xml-${domain}" = {
        listen = [{ addr = "0.0.0.0"; port = 80; }];
        root = "${dataDir}";

        extraConfig = ''
            index index.php;
            autoindex on;
            keepalive_timeout 1d;
            send_timeout 1d;
            client_body_timeout 1d;
            client_header_timeout 1d;
            proxy_connect_timeout 1d;
            proxy_read_timeout 1d;
            proxy_send_timeout 1d;
            fastcgi_connect_timeout 1d;
            fastcgi_read_timeout 1d;
            fastcgi_send_timeout 1d;
            memcached_connect_timeout 1d;
            memcached_read_timeout 1d;
            memcached_send_timeout 1d;
        '';
        locations."/" = {
          extraConfig = ''
             proxy_pass_request_headers on;
             try_files $uri $uri/ /index.php?$query_string;
          '';
        };

        locations."~ \\.php$" = {
          extraConfig = ''
            include ${config.services.nginx.package}/conf/fastcgi_params;
            include ${pkgs.nginx}/conf/fastcgi.conf;
            fastcgi_split_path_info ^(.+\.php)(.*)$;
            fastcgi_pass unix:${config.services.phpfpm.pools.${app}.socket};
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO $fastcgi_path_info;
            try_files $uri $uri/ /index.php?$args;
            proxy_pass_request_headers on;
          '';
        };

      };


			${domain} = {
				root = "${dataDir}";

				extraConfig = ''
						index index.php;
				'';

				forceSSL = true;
				sslCertificate = certfile;
				sslCertificateKey = certkeyfile;

				locations."~ ^(.+\\.php)(.*)$" = {
					extraConfig = ''
						# Check that the PHP script exists before passing it
						try_files $fastcgi_script_name =404;
						include ${config.services.nginx.package}/conf/fastcgi_params;
						fastcgi_split_path_info ^(.+\.php)(.*)$;
						#fastcgi_split_path_info ^(.+\.php)(/.+)$;
						fastcgi_pass unix:${config.services.phpfpm.pools.${app}.socket};
						fastcgi_param  SCRIPT_FILENAME  $document_root$fastcgi_script_name;
						fastcgi_param  PATH_INFO        $fastcgi_path_info;
						include ${pkgs.nginx}/conf/fastcgi.conf;
						proxy_pass_request_headers on;
					'';
				};

				locations."/app/" = {
					extraConfig = ''
						# Any additional configuration for /app/ location
					'';
				};

				locations."/static/" = {
					extraConfig = ''
						# Any additional configuration for /static/ location
					'';
				};
				locations."/" = {
					extraConfig = ''
						 proxy_pass_request_headers on;
						 try_files $uri $uri/ /index.php?$query_string;
					'';
				};

				locations."~ \\.php$" = {
					extraConfig = ''
						include ${config.services.nginx.package}/conf/fastcgi_params;
						include ${pkgs.nginx}/conf/fastcgi.conf;
						fastcgi_split_path_info ^(.+\.php)(.*)$;
						fastcgi_pass unix:${config.services.phpfpm.pools.${app}.socket};
						fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
						fastcgi_param PATH_INFO $fastcgi_path_info;
						try_files $uri $uri/ /index.php?$args;
						proxy_pass_request_headers on;
					'';
				};
			};
		};
	};

  systemd.services."${app}-initial-index-php" = {
    serviceConfig.Type = "oneshot";
    wantedBy = [ "multi-user.target" ];
    script = ''

      if [ ! -f ${dataDir}/index.php ]; then
        mkdir -p ${dataDir}

        touch ${dataDir}/index.php

        echo "<h1> ${app} </h1>" >> ${dataDir}/index.php
        echo "<a href=\"./info.php\">phpinfo...</a>" >> ${dataDir}/index.php

        touch ${dataDir}/info.php

        echo "<?php" >> ${dataDir}/info.php
        echo "phpinfo();" >> ${dataDir}/info.php
        echo "?>" >> ${dataDir}/info.php

        chown -Rc ${app}:${app} ${dataDir}
      fi

    '';
  };

  # CERTBOT

  systemd.timers."${app}-cert-refresh" = {
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnCalendar = "*-*-* 01:00:00";
      Unit = "${app}-cert-refresh.service";
    };
  };

  systemd.services."${app}-cert-refresh" =
  let
  in
  {
    serviceConfig.Type = "oneshot";
    wantedBy = [ "multi-user.target" ];
    script = ''

      echo "Refresh Cert for: ${app} - ${domain}"

      export TMP_AWS_ACCESS_KEY_ID=$(${bin.aws} ssm get-parameter --name /letsencrypt/aws_access_key_id --output text --query Parameter.Value)
      export TMP_AWS_SECRET_ACCESS_KEY=$(${bin.aws} ssm get-parameter --name /letsencrypt/aws_secret_access_key --with-decryption --output text --query Parameter.Value)
      export TMP_AWS_REGION=$(${bin.aws} ssm get-parameter --name /letsencrypt/aws_region --output text --query Parameter.Value)
      export TMP_AWS_HOSTED_ZONE_DOMAIN=$(echo ${domain} | ${bin.awk} -F '.' '{ for(i=2; i<=NF; i++) { printf "%s", $i; if(i < NF) printf "." }; printf "\n" }')
      export TMP_AWS_HOSTED_ZONE_ID=$(${bin.aws} ssm get-parameter --name /letsencrypt/$TMP_AWS_HOSTED_ZONE_DOMAIN/aws_hosted_zone_id --output text --query Parameter.Value)


      export AWS_ACCESS_KEY_ID=$TMP_AWS_ACCESS_KEY_ID
      export AWS_SECRET_ACCESS_KEY=$TMP_AWS_SECRET_ACCESS_KEY
      export AWS_REGION=$TMP_AWS_REGION
      export AWS_HOSTED_ZONE_ID=$TMP_AWS_HOSTED_ZONE_ID

      if [[ -f ${certfile} ]]; then
        echo "$(date) - renewal fase" >> /tmp/lego-${domain}

        expiryDate=$(date -d "$(${bin.openssl} x509 -enddate -noout -in ${certfile} |cut -d= -f2)" +%s)
        currentDate=$(date +"%s")
        let daysToExpiration="($expiryDate-$currentDate) /86400"
        if [[ $daysToExpiration  -lt 30  ]];
          then
            echo "Certificate renwal" >> /tmp/lego-${domain}
            ${bin.lego} --email="${certEmail}" --domains="${domain}" --dns route53  --path ${certdir} renew
          else
            echo "Certificate is not eligible for renewal. Days to expiry: $daysToExpiration" >> /tmp/lego-${domain}
        fi
      else
        echo "$(date) - run fase" >> /tmp/lego-${domain}
        ${bin.lego} --email="${certEmail}" --domains="${domain}" --dns route53 --accept-tos=true --path ${certdir} run
      fi

      find ${certbasedir} -type d -exec chmod 770 {} \;
      find ${certbasedir} -type f -exec chmod 660 {} \;
      find ${certbasedir} -exec chgrp nginx {} \;

      systemctl restart nginx.service

    '';
  };

  # DEPLOY

  systemd.timers."${app}-s3-deploy" = {
    wantedBy = [ "timers.target" ];
    timerConfig = {
      OnBootSec = "1m";
      OnUnitActiveSec = "1m";
      Unit = "${app}-s3-deploy.service";
    };
  };

  systemd.services."${app}-s3-deploy" =
  let
      patchCmds = lib.strings.concatStrings (builtins.map (patchPair: ''
        ${bin.aws} ssm get-parameter --name ${patchPair.paramstore_key} --with-decryption --output text --query Parameter.Value > ${appDir}${patchPair.dest_path}
        '') envPatchList);
  in
  {
    serviceConfig.Type = "oneshot";
    wantedBy = [ "multi-user.target" ];
    script = ''

      mkdir -p ${dataDir}
      export PATH=$PATH:${pkgs.gzip}/bin:${pkgs.openssh}/bin
      export LOCAL_VERSION=$(cat ${appDir}/sourcecode_version_id)

      export COMPOSER_ALLOW_SUPERUSER=1
      export COMPOSER_HOME=${appDir}
      export HOME=/root

      ${bin.aws} s3api list-object-versions \
        --bucket ${artifactBucket} \
        --prefix ${tarfile} \
        | ${bin.jq} '.Versions | .[] | select(.IsLatest)|.VersionId' \
        > ${appDir}/sourcecode_version_id || echo "none" > ${appDir}/sourcecode_version_id

      export REMOTE_VERSION=$(cat ${appDir}/sourcecode_version_id)

      echo "S3-DEPLOY: Comparing local and remote versions"
      echo " local: $LOCAL_VERSION"
      echo " remote: $REMOTE_VERSION"

      if [[ "$LOCAL_VERSION" != "$REMOTE_VERSION" ]]; then

        echo "S3-DEPLOY: Install devkey in root"
        ${bin.aws} ssm get-parameter \
          --name /shared/iit_developer_keypair/private \
          --with-decryption --output text --query Parameter.Value > /root/.ssh/id_ed25519
        chmod 600 /root/.ssh/id_ed25519

        echo "S3-DEPLOY: Creating backup"
        ${bin.tar} czf ${appDir}/backup-$(date +"%Y_%m_%d_%I_%M_%p")-${tarfile} ${dataDir}

        echo "S3-DEPLOY: Removing earlier backups"
        ls -tp ${appDir}/backup-* | grep -v '/$'| tail -n +4 | xargs -I {} rm -- {}

        echo "S3-DEPLOY: Installing new version"
        ${bin.aws} s3 cp s3://${artifactBucket}/${tarfile} /tmp/
        rm -Rfv ${dataDir}
        mkdir -p ${dataDir}
        ${bin.tar} xzf /tmp/${tarfile} -C ${dataDir} --warning=no-unknown-keyword

        ln -s /data/${app}/data ${dataDir}/data
        mkdir -p /data/${app}/log
        mkdir -p ${dataDir}/xmls_in
        mkdir -p ${dataDir}/xmls_out
        mkdir -p ${dataDir}/rrslog
        
        ln -s /data/${app}/tmp ${dataDir}/tmp
        ln -s /data/${app}/uploads ${dataDir}/uploads
        ln -s /data/${app}/log ${dataDir}/alltrack-cust-rrs/log

        if [[ ! -f ${appDir}/data/rrslog/import/Manual.xml ]];
         then
          mkdir -p ${appDir}/data/rrslog/import
          echo "" > ${appDir}/data/rrslog/import/Manual.xml
        fi


        find /data/${app} -type d -exec chmod 6775 {} \;

        ## PHP Patching
        ${patchCmds}
        
        ## Setting Final permissions
        sleep 5
        find ${appDir} -not -user ${app} -exec chown -Rf ${app}:${app} {} \; 
        find /data/${app} -not -user ${app} -exec chown -Rf ${app}:${app} {} \;
        systemctl restart phpfpm-${app}.service
      fi
    '';
  };

  #	systemd.services."process-rrs-xml-queued-messages-${app}" = {
  #		description = "RRS XML queues messages processor";
  #		after = [ "network.target" ];
  #		startLimitBurst = 5;
  #		startLimitIntervalSec = 10;
  #
  #		serviceConfig = {
  #			Type = "simple";
  #			WorkingDirectory = "${dataDir}";
  #			StandardOutput = "journal";
  #			StandardError = "journal";
  #			ExecStart = "/run/current-system/sw/bin/zsh -l -c '${pkgs.${php_version}}/bin/php index.php cron process-xml-queued-messages'";
  #			Restart = "always";
  #			RestartSec = 3;
  #			User = "${app}";
  #			Group = "${app}";
  #		};
  #
  #		wantedBy = [ "multi-user.target" ];
  #	};
}
