+def cpe_vendors(derivation, vulns):
+    """Return CPE vendors per CVE for nodes matching this derivation's product.
+
+    Vulnix matches NVD advisories on the CPE product string alone; the vendor
+    parsed into each Node is never consulted. Emitting it lets consumers
+    recognise advisories that belong to an unrelated product which happens to
+    share a name with the scanned package.
+    """
+    products = set(derivation.product_candidates())
+    out = {}
+    for v in vulns:
+        vendors = sorted(
+            {n.vendor for n in v.nodes if n.product in products and n.vendor}
+        )
+        if vendors:
+            out[v.cve_id] = vendors
+    return out
+
